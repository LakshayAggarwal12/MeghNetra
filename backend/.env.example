PORT=5000
DATABASE_URL=postgresql://meghnetra:meghnetra@localhost:5432/meghnetra
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=change-me-shared-secret
JWT_SECRET=change-me-jwt-secret
CORS_ORIGIN=http://localhost:5173
WEATHER_POLL_INTERVAL_SECONDS=45
CORRELATION_TIME_WINDOW_HOURS=12
GEO_CLUSTER_EPS_KM=50
GEO_CLUSTER_MIN_POINTS=2
GEO_HOTSPOT_MIN_EVENTS=3

# RSS/news ingestion (comma-separated feed URLs; leave RSS_FEED_URLS empty to disable)
RSS_FEED_URLS=https://news.google.com/rss/search?q=flooding+India,https://news.google.com/rss/search?q=cyclone+India
RSS_POLL_INTERVAL_SECONDS=300
WEATHER_CITY_COOLDOWN_MINUTES=30

# Real weather API (OpenWeatherMap)
WEATHER_API_PROVIDER=openweathermap
# Option A: paste the key string directly
WEATHER_API_KEY=
# Option B: if your key is saved as a JSON file (e.g. {"api_key": "..."}),
# point to it instead of pasting the key above — leave WEATHER_API_KEY blank.
WEATHER_API_KEY_FILE=
